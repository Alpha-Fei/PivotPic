<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>PivotPic</AssemblyName>
    <RootNamespace>PivotPic</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 版本号由 build-release.ps1 按迭代计数器覆盖：主.次.迭代次数 -->
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>正画 PivotPic</Product>
    <AssemblyTitle>正画 PivotPic</AssemblyTitle>
    <Description>图片方向归一化与分辨率巡检工具</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    UseWindowsForms=true 仅供托盘 NotifyIcon 与目录选择器使用。
    它会让 SDK 生成 global using System.Windows.Forms 与 System.Drawing，
    导致 Application / Timer / Color / Point / Size / Brush 在每个 WPF 文件里全部歧义。
    这里移除这两个全局 using，需要 WinForms 的文件各自显式引用（如 TrayService）。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    卸载善后逻辑被主程序 / 安装程序 / 卸载程序三处共享，用链接编译而不是各写一份，
    避免三份拷贝将来改一处漏两处（漏了就会留下指向空端口的 PAC）。
  -->
  <ItemGroup>
    <Compile Include="..\Shared\ProxyCleanup.cs" Link="Services\ProxyCleanup.cs" />
  </ItemGroup>

  <!--
    内置加速组件随应用一起进输出目录，这样 dotnet run / 单元测试也能走真实链路。
    缺失时只警告不失败：没有它程序会静默降级直连，不影响任何既有功能。
  -->
  <ItemGroup>
    <None Include="..\..\third_party\gitport\gitport-github.exe"
          Condition="Exists('..\..\third_party\gitport\gitport-github.exe')"
          Link="proxy\gitport-github.exe"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\gitport\LICENSE-APACHE-2.0.txt"
          Condition="Exists('..\..\third_party\gitport\LICENSE-APACHE-2.0.txt')"
          Link="proxy\LICENSE-APACHE-2.0.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\gitport\NOTICE.txt"
          Condition="Exists('..\..\third_party\gitport\NOTICE.txt')"
          Link="proxy\NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\gitport\version.json"
          Condition="Exists('..\..\third_party\gitport\version.json')"
          Link="proxy\version.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
