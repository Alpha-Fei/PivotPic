<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        浅色主题色板。键名与 Colors.xaml 完全一致，运行时整体替换即可换肤。
        强调色比深色版略深，保证与白底的对比度不低于 4.5:1。
    -->

    <!-- ============ 表面 ============ -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.CardHover" Color="#FAFBFC" />
    <SolidColorBrush x:Key="Bg.Flyout" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="#EDEFF3" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#0A000000" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#14000000" />
    <SolidColorBrush x:Key="Bg.Scrim" Color="#66000000" />

    <!-- ============ 描边 ============ -->
    <SolidColorBrush x:Key="Stroke.Subtle" Color="#0F000000" />
    <SolidColorBrush x:Key="Stroke.Medium" Color="#1A000000" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#33000000" />

    <!-- ============ 文字 ============ -->
    <SolidColorBrush x:Key="Text.Primary" Color="#14161A" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5F6570" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8E949E" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#A8ADB5" />

    <!-- ============ 强调与语义 ============ -->
    <SolidColorBrush x:Key="Accent" Color="#5546E8" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#4438C4" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#3A2FB8" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#1F5546E8" />
    <SolidColorBrush x:Key="Accent.Glow" Color="#555546E8" />

    <SolidColorBrush x:Key="Success" Color="#22A06B" />
    <SolidColorBrush x:Key="Success.Soft" Color="#1F22A06B" />
    <SolidColorBrush x:Key="Danger" Color="#D93B2B" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#1FD93B2B" />
    <SolidColorBrush x:Key="Warning" Color="#C77700" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#1FC77700" />

    <!-- 图标默认笔触，随语义状态切换 -->
    <SolidColorBrush x:Key="Icon.Primary" Color="#2A2E36" />
    <SolidColorBrush x:Key="Icon.Secondary" Color="#6B7280" />
    <SolidColorBrush x:Key="Icon.OnAccent" Color="#FFFFFF" />

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="Radius.Window">20</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">14</sys:Double>
    <sys:Double x:Key="Font.Size.Title">16</sys:Double>
    <sys:Double x:Key="Font.Size.Display">20</sys:Double>

    <!-- ============ 动效时长（毫秒） ============ -->
    <Duration x:Key="Duration.Fast">0:0:0.16</Duration>
    <Duration x:Key="Duration.Base">0:0:0.24</Duration>

    <!-- ============ 间距 ============ -->
    <Thickness x:Key="Pad.Card">20,18,20,18</Thickness>
    <Thickness x:Key="Pad.Page">24,20,24,20</Thickness>

</ResourceDictionary>
