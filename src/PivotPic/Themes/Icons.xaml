<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全矢量图标系统。
        所有图标统一 24×24 视框、1.5px 描边、圆头圆角连接（见下方 IconPath 样式）。
        使用时只引用几何，颜色由 Stroke 绑定语义画刷决定，绝不为不同颜色复制几何。

        用法：
        <Path Style="{StaticResource IconPath}" Data="{DynamicResource Icon.Folder}" />
    -->

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource Icon.Primary}" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
    </Style>


