<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        深色主题色板（默认）。2026 几何极简：低饱和底色 + 单一强调色。
        所有界面元素一律通过 DynamicResource 引用，保证运行时可整体换肤。
    -->

    <!-- ============ 表面 ============ -->
    <SolidColorBrush x:Key="Bg.Window" Color="#0E0F12" />
    <SolidColorBrush x:Key="Bg.Card" Color="#16181D" />
    <SolidColorBrush x:Key="Bg.CardHover" Color="#1A1D24" />
    <SolidColorBrush x:Key="Bg.Flyout" Color="#1C1F26" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="#0A0B0E" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Bg.Scrim" Color="#99000000" />

    <!-- ============ 描边 ============ -->
    <SolidColorBrush x:Key="Stroke.Subtle" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Stroke.Medium" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#33FFFFFF" />

    <!-- ============ 文字 ============ -->
    <SolidColorBrush x:Key="Text.Primary" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#8A8F98" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#5C6169" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#4A4F57" />

    <!-- ============ 强调与语义 ============ -->
    <SolidColorBrush x:Key="Accent" Color="#5546E8" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#6C5FF0" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#4438C4" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#2E5546E8" />
    <SolidColorBrush x:Key="Accent.Glow" Color="#665546E8" />

    <SolidColorBrush x:Key="Success" Color="#3DDC97" />
    <SolidColorBrush x:Key="Success.Soft" Color="#293DDC97" />
    <SolidColorBrush x:Key="Danger" Color="#FF6B5E" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#2EFF6B5E" />
    <SolidColorBrush x:Key="Warning" Color="#FFB84D" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#2EFFB84D" />

    <!-- 图标默认笔触，随语义状态切换 -->
    <SolidColorBrush x:Key="Icon.Primary" Color="#E6E8EC" />
    <SolidColorBrush x:Key="Icon.Secondary" Color="#8A8F98" />
    <SolidColorBrush x:Key="Icon.OnAccent" Color="#FFFFFF" />

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="Radius.Window">20</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">14</sys:Double>
    <sys:Double x:Key="Font.Size.Title">16</sys:Double>
    <sys:Double x:Key="Font.Size.Display">20</sys:Double>

    <!-- ============ 动效时长（毫秒） ============ -->
    <Duration x:Key="Duration.Fast">0:0:0.16</Duration>
    <Duration x:Key="Duration.Base">0:0:0.24</Duration>

    <!-- ============ 间距 ============ -->
    <Thickness x:Key="Pad.Card">20,18,20,18</Thickness>
    <Thickness x:Key="Pad.Page">24,20,24,20</Thickness>

</ResourceDictionary>
