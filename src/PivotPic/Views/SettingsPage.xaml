<UserControl x:Class="PivotPic.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource Font.UI}">

    <!--
        设置页：五张分组卡片，全部控件即时写回配置。
        颜色 / 圆角 / 字体一律 DynamicResource。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,6,0">
        <StackPanel Margin="24,20,24,20" MaxWidth="860" HorizontalAlignment="Stretch">

            <TextBlock Text="设置" FontSize="18" Style="{StaticResource Typo.Title}" />
            <TextBlock Text="所有改动即时生效并自动保存" Margin="0,8,0,20"
                       Style="{StaticResource Typo.Secondary}" />

            <!-- ==================== 1. 行为 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="行为" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="控制旋转方向、旋转方式，以及关闭主窗口时的处理。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="旋转方向" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <ComboBox x:Name="CmbRotateDirection" Grid.Column="1"
                                  Width="220" HorizontalAlignment="Left"
                                  Style="{StaticResource Combo.Base}"
                                  ItemContainerStyle="{StaticResource Combo.Item}"
                                  SelectionChanged="OnRotateDirectionChanged">
                            <ComboBoxItem Content="顺时针 90°" />
                            <ComboBoxItem Content="逆时针 90°" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="旋转方式" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="CmbRotationMode" Width="220" HorizontalAlignment="Left"
                                      Style="{StaticResource Combo.Base}"
                                      ItemContainerStyle="{StaticResource Combo.Item}"
                                      SelectionChanged="OnRotationModeChanged">
                                <ComboBoxItem Content="物理旋转 · 高性能引擎" />
                                <ComboBoxItem Content="物理旋转 · 内置引擎" />
                                <ComboBoxItem Content="仅改写 EXIF 标记" />
                            </ComboBox>
                            <Path Width="16" Height="16" Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource IconPath}"
                                  Data="{DynamicResource Icon.Info}"
                                  Stroke="{DynamicResource Icon.Secondary}"
                                  ToolTip="高性能引擎用 libvips 流式处理，内存占用低、大图更快；内置引擎为 Windows 自带的图像管线；EXIF 方式零画质损失但部分老软件读不出方向" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="关闭主窗口时" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <ComboBox x:Name="CmbCloseAction" Grid.Column="1"
                                  Width="220" HorizontalAlignment="Left"
                                  Style="{StaticResource Combo.Base}"
                                  ItemContainerStyle="{StaticResource Combo.Item}"
                                  SelectionChanged="OnCloseActionChanged">
                            <ComboBoxItem Content="最小化到托盘" />
                            <ComboBoxItem Content="直接退出" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="处理时显示进度" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleProgressPopup"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          Click="OnProgressPopupClick" />
                            <TextBlock Text="处理图片时在窗口底部显示进度条，完成后自动关闭"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 1.5 处理上限（仅内置引擎需要） ==================== -->
            <Border x:Name="MaxPixelsCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="处理上限" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="超过上限的图片会被跳过。喷绘、写真这类超大图可以适当调高，代价是更吃内存。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大像素数" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="MaxPixelsBox" Width="96" Height="32"
                                     Style="{StaticResource Input.Text}"
                                     Padding="10,0"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OnMaxPixelsLostFocus"
                                     KeyDown="OnMaxPixelsKeyDown"
                                     PreviewTextInput="OnMaxPixelsPreviewTextInput" />
                            <TextBlock Text="兆像素（MP）" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                            <TextBlock x:Name="MaxPixelsHint" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 1.55 JPEG 兼容模式 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="JPEG 兼容模式" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="连续（progressive）JPEG 打印 RIP 无法识别，开启后会自动转为基线标准（保留色彩配置与 DPI）；竖版图同样会转换。"
                               Margin="0,6,0,14" Style="{StaticResource Typo.Secondary}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="连续 JPEG 转基线" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <ToggleButton x:Name="ToggleConvertProgressive" Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource Toggle.Switch}"
                                      Click="OnConvertProgressiveClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 1.6 文件名标记 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="文件名标记" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="旋转成功后，在文件名末尾追加标记，方便一眼看出哪些图已经处理过。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="添加标记" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleSuffix"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          Click="OnSuffixToggleClick" />
                            <TextBox x:Name="SuffixBox" Width="150" Height="32" Margin="14,0,0,0"
                                     Style="{StaticResource Input.Text}"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OnSuffixLostFocus"
                                     KeyDown="OnSuffixKeyDown"
                                     PreviewTextInput="OnSuffixPreviewTextInput" />
                            <TextBlock x:Name="SuffixHint" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 2. 外观 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="主题切换立即生效，无需重启。" Margin="0,6,0,18"
                               Style="{StaticResource Typo.Secondary}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <ComboBox x:Name="CmbTheme" Grid.Column="1"
                                  Width="220" HorizontalAlignment="Left"
                                  Style="{StaticResource Combo.Base}"
                                  ItemContainerStyle="{StaticResource Combo.Item}"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="深色" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="跟随系统" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 3. 启动 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="开机后静默启动，只驻留托盘，不弹出窗口。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="开机自动启动" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleAutoStart" Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          Click="OnAutoStartClick" />
                            <TextBlock x:Name="AutoStartHint" Text="写入当前用户启动项（HKCU\...\Run）" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 4. 更新与网络 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="更新与网络" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="从 GitHub 检查新版本，网络不稳时自动加速。加速只接管 GitHub 域名，退出后自动还原。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}"
                               TextWrapping="Wrap" />

                    <!-- 自动检查更新 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自动检查更新" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleAutoUpdate"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          Click="OnAutoUpdateClick" />
                            <TextBlock x:Name="AutoUpdateHint" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- 当前版本 + 手动检查 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前版本" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="CurrentVersionText" VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Mono}" />
                            <Button x:Name="BtnCheckUpdate" Content="检查更新"
                                    Style="{StaticResource Btn.Secondary}"
                                    Margin="14,0,0,0"
                                    Click="OnCheckUpdateClick" />
                            <Button x:Name="BtnViewUpdate" Content="查看新版本"
                                    Style="{StaticResource Btn.Primary}"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Click="OnViewUpdateClick" />
                        </StackPanel>
                    </Grid>

                    <!-- 网络加速 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="网络加速" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleProxy"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          Click="OnProxyToggleClick" />
                            <Ellipse x:Name="ProxyDot" Width="6" Height="6" Margin="14,0,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Text.Tertiary}" />
                            <TextBlock x:Name="ProxyStatusText" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- 系统级 GitHub 分流 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="系统级 GitHub 分流" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleSystemPac"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          Click="OnSystemPacToggleClick" />
                            <TextBlock Text="仅接管 GitHub 域名，退出自动还原" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Typo.Secondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- 上次检查 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="上次检查" VerticalAlignment="Center"
                                   Style="{StaticResource Typo.Body}" />
                        <TextBlock x:Name="LastCheckText" Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Typo.Mono}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 5. 配置 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="配置" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="把当前配置导出备份，或从备份文件恢复。导入会覆盖现有配置。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="导出配置" Style="{StaticResource Btn.Secondary}"
                                Click="OnExportClick" />
                        <Button Content="导入配置" Style="{StaticResource Btn.Secondary}"
                                Margin="10,0,0,0" Click="OnImportClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 6. 占位符帮助 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="目录占位符" Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="目录路径支持时间占位符，每次展开时按当前时间替换。"
                               Margin="0,6,0,18" Style="{StaticResource Typo.Secondary}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{}{mm-dd}" Style="{StaticResource Typo.Mono}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="11-04"
                                   Style="{StaticResource Typo.Mono}"
                                   Foreground="{DynamicResource Text.Primary}" />

                        <TextBlock Grid.Row="1" Text="{}{yyyy}-{mm}-{dd}" Margin="0,8,0,0"
                                   Style="{StaticResource Typo.Mono}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="2026-11-04" Margin="0,8,0,0"
                                   Style="{StaticResource Typo.Mono}"
                                   Foreground="{DynamicResource Text.Primary}" />

                        <TextBlock Grid.Row="2" Text="{}{yyyyMMdd}" Margin="0,8,0,0"
                                   Style="{StaticResource Typo.Mono}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="20261104" Margin="0,8,0,0"
                                   Style="{StaticResource Typo.Mono}"
                                   Foreground="{DynamicResource Text.Primary}" />

                        <TextBlock Grid.Row="3" Text="{}{HH}-{mi}-{ss}" Margin="0,8,0,0"
                                   Style="{StaticResource Typo.Mono}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="09:15:32" Margin="0,8,0,0"
                                   Style="{StaticResource Typo.Mono}"
                                   Foreground="{DynamicResource Text.Primary}" />
                    </Grid>

                    <TextBlock Text="mm 表示月份，mi 表示分钟。" Margin="0,16,0,0"
                               Foreground="{DynamicResource Warning}"
                               Style="{StaticResource Typo.Secondary}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
