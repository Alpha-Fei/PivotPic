<Window x:Class="PivotPic.Views.AddFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监控目录"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

<!-- 24px 透明边距留给双层阴影 -->
    <Grid Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
        </Grid.RenderTransform>

        <Border x:Name="CardRoot"
                Width="480"
                CornerRadius="12"
                BorderThickness="1"
                Background="{DynamicResource Bg.Flyout}"
                BorderBrush="{DynamicResource Stroke.Medium}">

            <!-- 双层阴影：外层大扩散悬浮感 + 内层小扩散厚度感 -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ══════════ 标题区 ══════════ -->
                <Grid Grid.Row="0" Margin="24,22,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="添加监控目录"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" />
                    </StackPanel>
                </Grid>

                <!-- ══════════ 输入区 ══════════ -->
                <StackPanel Grid.Row="1" Margin="24,18,24,0">

                    <!-- 路径输入 + 浏览按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 输入框：嵌套深色底 + 聚焦紫色光晕 -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="PathInput"
                                     Height="32"
                                     Padding="5,0"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     FontSize="13"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent}"
                                     TextChanged="OnPathTextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Medium}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- 聚焦态：紫色描边 + 外发光 -->
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0"
                                                                          Opacity="0.55" Color="#5546E8" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- 占位符水印 -->
                        </Grid>

                        <!-- 浏览按钮：矢量文件夹图标 -->
                        <Button Grid.Column="1"
                                Width="40"
                                Height="32"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="浏览文件夹"
                                Click="OnBrowseClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource Stroke.Medium}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Medium}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Stroke.Strong}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.04" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <!-- 矢量文件夹图标（StreamGeometry 描边风格） -->
                            <Path Width="17" Height="17"
                                  Data="{DynamicResource Icon.FolderPlus}"
                                  Fill="{DynamicResource Text.Primary}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- 实时预览行（默认隐藏，逻辑保留） -->
                    <Grid Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="13" Height="13"
                              Data="{DynamicResource Icon.Info}"
                              Fill="{DynamicResource Text.Tertiary}"
                              Stretch="Uniform"
                              VerticalAlignment="Top"
                              Margin="1,2,0,0" />
                        <TextBlock x:Name="PreviewText"
                                   Grid.Column="1"
                                   Margin="7,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- ══════════ 操作区：分隔线 + 按钮 ══════════ -->
                <StackPanel Grid.Row="2" Margin="24,20,24,22">
                    <!-- 1px 分隔线 -->
                    <Border Height="1" HorizontalAlignment="Stretch" Margin="0,0,0,18">
                        <Border.Background>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.06" />
                        </Border.Background>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：智能转换按钮 -->
                        <Button Grid.Column="0"
                                Height="36"
                                MinWidth="112"
                                Padding="18,0"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                ToolTip="把路径中的日期（如 11-04）自动替换为 {mm-dd} 等占位符"
                                Click="OnConvertPlaceholderClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="14" Height="14"
                                      Data="{DynamicResource Icon.Rotate}"
                                      Stroke="{DynamicResource Text.Secondary}"
                                      StrokeThickness="1.5"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="转换日期"
                                           Margin="6,0,0,0"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#FFFFFF" Opacity="0.05" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Medium}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#FFFFFF" Opacity="0.1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 右侧：取消 + 确定 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- 取消：玻璃按钮 -->
                        <Button Content="取消"
                                Height="36"
                                MinWidth="76"
                                Padding="16,0"
                                Cursor="Hand"
                                Click="OnCancelClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#FFFFFF" Opacity="0.06" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Stroke.Strong}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 确定：品牌紫渐变 + hover 微放大 -->
                        <Button x:Name="ConfirmButton"
                                Content="确定"
                                Height="36"
                                MinWidth="88"
                                Padding="18,0"
                                Margin="10,0,0,0"
                                Cursor="Hand"
                                Click="OnConfirmClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="10"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#5546E8" Offset="0" />
                                                            <GradientStop Color="#6C5FF0" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#6C5FF0" Offset="0" />
                                                                    <GradientStop Color="#7C70F5" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                                                  Opacity="0.5" Color="#5546E8" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#4438C4" Offset="0" />
                                                                    <GradientStop Color="#5A4DE0" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
