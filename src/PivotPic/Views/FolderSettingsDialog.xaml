<Window x:Class="PivotPic.Views.FolderSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="目录设置"
        Width="640" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal"
        xmlns:behaviors="clr-namespace:PivotPic.Behaviors"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Border Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题区（可拖动） -->
            <Grid Grid.Row="0" Margin="24,20,16,0" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel>
                    <TextBlock Text="目录设置" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock x:Name="PathText" FontSize="11" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Text.Tertiary}" />
                </StackPanel>

                <Button Style="{StaticResource Btn.DialogClose}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-4,-2,0"
                        Click="OnCloseClick"
                        ToolTip="关闭（Esc）">
                    <Path Width="13" Height="13"
                          Style="{StaticResource IconPath}"
                          Data="{DynamicResource Icon.Close}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- 设置项 -->
            <!-- 固定高度 + 滚轮滚动，但不显示滚动条（Hidden 仍可滚动，Disabled 才不可滚）。 -->
            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,8">

                    <!-- 监控路径：手写模板 / 浏览目录 / 一键转占位符 -->
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="监控路径" Style="{StaticResource Typo.Body}" />
                                    <TextBlock Text="可插入 {mm-dd} 这类时间占位符，每天自动换目录"
                                               Margin="0,3,0,0" Style="{StaticResource Typo.Secondary}" />
                                </StackPanel>

                                <!-- 右侧操作：浏览目录 / 把日期转成占位符 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="8,0"
                                            Cursor="Hand"
                                            Click="OnBrowsePathClick"
                                            ToolTip="浏览并选择文件夹">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14"
                                                  Style="{StaticResource IconPath}"
                                                  Data="{DynamicResource Icon.FolderPlus}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="浏览" Margin="5,0,0,0" FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="8,0" Margin="6,0,0,0"
                                            Cursor="Hand"
                                            Click="OnConvertPathClick"
                                            ToolTip="把路径里的日期（如 11-06）替换成 {mm}-{dd}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14"
                                                  Style="{StaticResource IconPath}"
                                                  Data="{DynamicResource Icon.Rotate}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="转占位符" Margin="5,0,0,0" FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 路径输入框：等宽字体，聚焦紫色描边 -->
                            <TextBox x:Name="PathInput" Height="34" Margin="0,10,0,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="OnPathKeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
                                        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Text" Value="{Binding EditingPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- 占位符快捷插入 -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="插入" VerticalAlignment="Center"
                                           Style="{StaticResource Typo.Secondary}" />
                                <Button Content="{}{mm-dd}" Tag="{}{mm-dd}" Margin="8,0,0,0"
                                        Style="{StaticResource Btn.Chip}" Click="OnInsertTokenClick"
                                        ToolTip="月-日，例如 11-06" />
                                <Button Content="{}{yyyyMMdd}" Tag="{}{yyyyMMdd}"
                                        Style="{StaticResource Btn.Chip}" Click="OnInsertTokenClick"
                                        ToolTip="年月日，例如 20261106" />
                                <Button Content="{}{hhmmss}" Tag="{}{hhmmss}"
                                        Style="{StaticResource Btn.Chip}" Click="OnInsertTokenClick"
                                        ToolTip="时分秒，例如 153042" />
                            </StackPanel>

                            <!-- 实时预览：占位符会展开成什么；有未识别占位符时转警告色 -->
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Path Width="13" Height="13" Margin="1,1,0,0"
                                      Style="{StaticResource IconPath}"
                                      Data="{DynamicResource Icon.Info}"
                                      Stroke="{DynamicResource Text.Tertiary}"
                                      VerticalAlignment="Top" />
                                <TextBlock Text="{Binding EditingPreviewLine}" Margin="7,0,0,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEditingUnknown}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 子文件夹：包含开关 + 联动的忽略名单，同属一组 -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="包含子文件夹" Style="{StaticResource Typo.Body}" />
                                    <TextBlock Text="连子目录里新落地的图片一起处理"
                                               Margin="0,3,0,0" Style="{StaticResource Typo.Secondary}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}" />
                            </Grid>

                            <!-- 忽略名单：只有开启「包含子文件夹」才有意义，关掉时整体平滑收起 -->
                            <StackPanel x:Name="IgnoreSection" Margin="0,14,0,0"
                                        ClipToBounds="True"
                                        behaviors:Reveal.IsExpanded="{Binding IncludeSubdirectories}">
                                <Border Height="1" Background="{DynamicResource Stroke.Subtle}"
                                        Margin="0,0,0,14" />

                                <TextBlock Text="忽略的子文件夹" Style="{StaticResource Typo.Body}" />
                                <TextBlock Text="名称匹配的子文件夹，里面的图片变动一律不处理"
                                           Margin="0,3,0,0" Style="{StaticResource Typo.Secondary}" />

                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Width="132" Height="30" Tag="ignore"
                                             Style="{StaticResource Input.Text}"
                                             Padding="9,0" FontSize="11"
                                             VerticalContentAlignment="Center"
                                             ToolTip="输入文件夹名，回车添加（如：已打、备份）"
                                             KeyDown="OnIgnoredFolderKeyDown"
                                             LostFocus="OnIgnoredFolderLostFocus" />
                                    <ItemsControl ItemsSource="{Binding IgnoredFolders}" Margin="10,0,0,0"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Bg.Sunken}" CornerRadius="5"
                                                        Padding="7,3,4,3" Margin="0,2,6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text.Secondary}" />
                                                        <Button Content="✕" FontSize="9" Width="16" Height="16"
                                                                Margin="4,0,0,0" Padding="0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource Text.Tertiary}"
                                                                Cursor="Hand" Tag="{Binding}"
                                                                Click="OnRemoveIgnoredFolderClick"
                                                                ToolTip="移除" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 分辨率检查 -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="分辨率检查" Style="{StaticResource Typo.Body}" />
                                    <TextBlock Text="超越阈值时在右下角提醒，并可在资源管理器定位"
                                               Margin="0,3,0,0" Style="{StaticResource Typo.Secondary}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ResolutionCheckEnabled, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        IsEnabled="{Binding ResolutionCheckEnabled}">
                                <TextBlock Text="阈值" VerticalAlignment="Center"
                                           Style="{StaticResource Typo.Secondary}" />
                                <TextBox Width="86" Height="32" Margin="10,0,0,0"
                                         Style="{StaticResource Input.Text}"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         PreviewTextInput="OnThresholdPreviewTextInput"
                                         LostFocus="OnThresholdLostFocus"
                                         Text="{Binding ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="允许范围 1 – 100000" />
                                <ComboBox Width="150" Margin="8,0,0,0"
                                          Style="{StaticResource Combo.Base}"
                                          ItemContainerStyle="{StaticResource Combo.Item}"
                                          SelectedIndex="{Binding MetricIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="长边像素" />
                                    <ComboBoxItem Content="短边像素" />
                                    <ComboBoxItem Content="总像素（万）" />
                                    <ComboBoxItem Content="文件体积（KB）" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 成品幅面上限 -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="成品幅面上限" Style="{StaticResource Typo.Body}" />
                                    <TextBlock Text="按像素 ÷ DPI 换算成品尺寸，宽和高都超过才跳过旋转"
                                               Margin="0,3,0,0" Style="{StaticResource Typo.Secondary}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding SizeLimitEnabled, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        IsEnabled="{Binding SizeLimitEnabled}">
                                <TextBlock Text="上限" VerticalAlignment="Center"
                                           Style="{StaticResource Typo.Secondary}" />
                                <TextBox Width="76" Height="32" Margin="10,0,0,0"
                                         Style="{StaticResource Input.Text}"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         PreviewTextInput="OnThresholdPreviewTextInput"
                                         KeyDown="OnMaxSideCmKeyDown"
                                         LostFocus="OnMaxSideCmLostFocus"
                                         Text="{Binding MaxSideCmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="允许范围 1 – 10000 厘米" />
                                <TextBlock Text="厘米" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource Typo.Secondary}" />
                            </StackPanel>

                            <!-- 关键词规则 -->
                            <StackPanel Margin="0,10,0,0" IsEnabled="{Binding SizeLimitEnabled}">
                                <TextBlock Text="文件名规则（命中关键词时改用对应上限，多条取最长匹配）"
                                           Style="{StaticResource Typo.Secondary}" />
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox Width="96" Height="30" Tag="kw"
                                             Style="{StaticResource Input.Text}"
                                             Padding="9,0" FontSize="11"
                                             VerticalContentAlignment="Center"
                                             ToolTip="文件名关键词，如 UV" />
                                    <TextBox Width="62" Height="30" Margin="6,0,0,0" Tag="cm"
                                             Style="{StaticResource Input.Text}"
                                             Padding="9,0" FontSize="11"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             ToolTip="该关键词对应的上限（厘米）" />
                                    <TextBlock Text="厘米" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource Typo.Secondary}" />
                                    <Button Content="添加" Height="30" Margin="8,0,0,0"
                                            Style="{StaticResource Btn.Ghost}"
                                            Click="OnAddSizeRuleClick" />

                                    <ItemsControl ItemsSource="{Binding SizeRuleChips}" Margin="12,0,0,0"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Bg.Sunken}" CornerRadius="5"
                                                        Padding="7,3,4,3" Margin="0,2,6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Display}" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text.Secondary}" />
                                                        <Button Content="✕" FontSize="9" Width="16" Height="16"
                                                                Margin="4,0,0,0" Padding="0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource Text.Tertiary}"
                                                                Cursor="Hand" Tag="{Binding}"
                                                                Click="OnRemoveSizeRuleClick"
                                                                ToolTip="移除" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="2" Margin="24,10,24,18">
                <TextBlock Text="改动即时生效并自动保存" VerticalAlignment="Center"
                           Style="{StaticResource Typo.Secondary}" />
                <Button Content="完成" HorizontalAlignment="Right" Width="88" Height="34"
                        Style="{StaticResource Btn.Primary}"
                        Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
