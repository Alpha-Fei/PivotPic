<UserControl x:Class="PivotPic.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PivotPic.Behaviors"
             Background="Transparent"
             FontFamily="{DynamicResource Font.UI}"
             AllowDrop="True"
             DragOver="OnPageDragOver"
             DragLeave="OnPageDragLeave"
             Drop="OnPageDrop">

    <!--
        监控页：总控条 + 目录卡片滚动区 + 空态。
        所有颜色/圆角/字体一律 DynamicResource，尺寸（宽高/字号/Margin）直接写数字。
    -->

    <UserControl.Resources>

        <!-- 卡片操作按钮：常显，图标颜色跟随按钮前景色（hover 时由 Btn.Ghost 提亮） -->
        <Style x:Key="Btn.CardAction" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Foreground" Value="{DynamicResource Icon.Secondary}" />
        </Style>

        <!-- 带文字的卡片按钮（扫描）：宽度自适应，不裁切文字 -->
        <Style x:Key="Btn.CardActionText" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Icon.Secondary}" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="RootGrid" Margin="24,20,24,20" RenderTransformOrigin="0.5,0.5"
              AllowDrop="True">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== 1. 总控条 ==================== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{DynamicResource Success}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="监控中" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Typo.Body}" FontWeight="SemiBold" />
                    <TextBlock Text="·" Margin="10,0" VerticalAlignment="Center"
                               Style="{StaticResource Typo.Secondary}" />
                    <TextBlock x:Name="TodayText" Text="今日处理 0 张" VerticalAlignment="Center"
                               Style="{StaticResource Typo.Mono}" />
                    <TextBlock Text="·" Margin="10,0" VerticalAlignment="Center"
                               Style="{StaticResource Typo.Secondary}" />
                    <TextBlock x:Name="AlertText" Text="告警 0 条" VerticalAlignment="Center"
                               Style="{StaticResource Typo.Mono}" />
                    <Border x:Name="AlertBadge" Style="{StaticResource Badge.Danger}"
                            Margin="10,0,0,0" Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <TextBlock x:Name="AlertBadgeText" Text="0"
                                   Style="{StaticResource Typo.Mono}"
                                   Foreground="{DynamicResource Danger}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="监控开关" Margin="0,0,10,0" VerticalAlignment="Center"
                               Style="{StaticResource Typo.Secondary}" />
                    <ToggleButton x:Name="MasterToggle" Style="{StaticResource Toggle.Switch}"
                                  VerticalAlignment="Center"
                                  Click="OnMasterToggleClick"
                                  ToolTip="关闭后停止全部目录监控，各目录自身的开关保持不变" />
                </StackPanel>

                <Border Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource Stroke.Subtle}" />
            </Grid>

            <!-- ==================== 2. 卡片滚动区 / 3. 空态 ==================== -->
            <Grid Grid.Row="1" Margin="0,14,0,0">

                <ScrollViewer x:Name="CardScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl x:Name="FolderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Hover}" Margin="0,0,0,10" Padding="14,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Path Width="18" Height="18"
                                                      Style="{StaticResource IconPath}"
                                                      Data="{DynamicResource Icon.Folder}"
                                                      Stroke="{DynamicResource Icon.Secondary}"
                                                      VerticalAlignment="Center" />

                                                <!-- 路径 + 实际路径 -->
                                                <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding DisplayPath}"
                                                               ToolTip="{Binding PathTooltip}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MouseLeftButtonUp="OnPathClick">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Typo.Body}">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Row="1" Text="{Binding ResolvedLine}"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Typo.Mono}">
                                                                <Setter Property="FontSize" Value="11" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUnknownTokens}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- 状态 + 启用开关 + 操作 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Margin="0,0,12,0" Padding="8,2" CornerRadius="6"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Background" Value="{DynamicResource Bg.Sunken}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                                                        <Setter Property="Background" Value="#22D9534F" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <ToggleButton Style="{StaticResource Toggle.Switch}"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                  ToolTip="关闭后此目录不再响应新文件" />

                                                    <Rectangle Width="1" Height="18" Margin="12,0,6,0"
                                                               Fill="{DynamicResource Stroke.Subtle}"
                                                               VerticalAlignment="Center" />

                                                    <Button Style="{StaticResource Btn.CardAction}"
                                                            Click="OnFolderSettingsClick"
                                                            ToolTip="目录设置：子文件夹、分辨率检查、忽略名单、幅面上限">
                                                        <Path Width="16" Height="16"
                                                              Style="{StaticResource IconPath}"
                                                              Data="{DynamicResource Icon.Settings}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>

                                                    <Button Style="{StaticResource Btn.CardActionText}"
                                                            Margin="2,0,0,0"
                                                            Click="OnScanFolderClick"
                                                            ToolTip="立即全量扫描此目录">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="14" Height="14"
                                                                  Style="{StaticResource IconPath}"
                                                                  Data="{DynamicResource Icon.Search}"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  VerticalAlignment="Center" />
                                                            <TextBlock Text="扫描" Margin="5,0,0,0" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource Btn.CardAction}"
                                                            Margin="2,0,0,0"
                                                            Click="OnOpenFolderClick"
                                                            ToolTip="在资源管理器中打开">
                                                        <Path Width="16" Height="16"
                                                              Style="{StaticResource IconPath}"
                                                              Data="{DynamicResource Icon.Folder}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>

                                                    <Button Style="{StaticResource Btn.CardAction}"
                                                            Margin="2,0,0,0"
                                                            Foreground="{DynamicResource Danger}"
                                                            Click="OnDeleteFolderClick"
                                                            ToolTip="删除此目录">
                                                        <Path Width="16" Height="16"
                                                              Style="{StaticResource IconPath}"
                                                              Data="{DynamicResource Icon.Trash}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 扫描进度（仅扫描时出现，高度平滑展开/收起） -->
                                            <Grid x:Name="ScanRow" Margin="30,10,0,0"
                                                  ClipToBounds="True"
                                                  behaviors:Reveal.IsExpanded="{Binding IsScanning}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Height="2" CornerRadius="1"
                                                        Background="{DynamicResource Stroke.Subtle}">
                                                    <Border Background="{DynamicResource Accent}"
                                                            CornerRadius="1"
                                                            RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding ScanFraction}" ScaleY="1" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>

                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding ScanText}" HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Typo.Mono}" />
                                                    <Button Content="取消" HorizontalAlignment="Right"
                                                            Style="{StaticResource Btn.Ghost}"
                                                            Click="OnCancelScanClick" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 列表末尾的虚线添加卡片：Border 不支持虚线，用 Rectangle 描边实现 -->
                        <Grid x:Name="AddCard" Height="76" Margin="0,0,0,12"
                              Cursor="Hand" Background="Transparent"
                              MouseLeftButtonUp="OnAddFolderClick"
                              ToolTip="点击选择目录，也可以直接把文件夹拖进窗口">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.82" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle RadiusX="16" RadiusY="16" Fill="Transparent"
                                       Stroke="{DynamicResource Stroke.Medium}"
                                       StrokeThickness="1"
                                       StrokeDashArray="4 3" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="20" Height="20"
                                      Style="{StaticResource IconPath}"
                                      Data="{DynamicResource Icon.FolderPlus}"
                                      Stroke="{DynamicResource Icon.Secondary}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="添加监控目录" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Typo.Body}"
                                           Foreground="{DynamicResource Icon.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="96" Height="96" HorizontalAlignment="Center"
                           Source="{DynamicResource Image.BrandSymbol}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="尚未添加监控目录" Margin="0,22,0,0" HorizontalAlignment="Center"
                               Style="{StaticResource Typo.Title}" />
                    <TextBlock Text="添加后，横版图片会自动转为竖版" Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Typo.Secondary}" />
                    <Button Content="添加监控目录" Margin="0,24,0,0" HorizontalAlignment="Center"
                            Style="{StaticResource Btn.Primary}"
                            Click="OnAddFolderClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 拖拽高亮层 -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                BorderThickness="2" Margin="12,8,12,8"
                BorderBrush="{DynamicResource Accent}"
                CornerRadius="{DynamicResource Radius.Card}" />
    </Grid>
</UserControl>
