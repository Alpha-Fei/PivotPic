<Window x:Class="PivotPic.Views.UpdateDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新详情"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!--
            细进度条：默认 WPF ProgressBar 在深色底上是一条灰槽 + 高亮块，和整站的圆角玻璃语言冲突。
            这里用最小模板重写：圆角轨道 + 圆角指示块，颜色全部走主题令牌。
        -->
        <Style x:Key="Progress.Thin" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Bg.Sunken}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#5546E8" Offset="0" />
                                            <GradientStop Color="#7C70F5" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 24px 透明边距留给双层阴影 -->
    <Grid Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
        </Grid.RenderTransform>

        <Border x:Name="CardRoot"
                Width="560"
                CornerRadius="12"
                BorderThickness="1"
                Background="{DynamicResource Bg.Flyout}"
                BorderBrush="{DynamicResource Stroke.Medium}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.14" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ══════════ 标题区 ══════════ -->
                <Grid Grid.Row="0" Margin="24,22,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="发现新版本"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" />

                        <!-- 旧版 → 新版 对比 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="VersionFromText"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       VerticalAlignment="Center" />
                            <Path Width="10" Height="10" Margin="8,0"
                                  Style="{StaticResource IconPath}"
                                  Data="{DynamicResource Icon.ChevronRight}"
                                  Stroke="{DynamicResource Text.Tertiary}"
                                  VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge.Accent}">
                                <TextBlock x:Name="VersionToText"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource Btn.DialogClose}"
                            VerticalAlignment="Top"
                            ToolTip="关闭"
                            Click="OnCloseClick">
                        <Path Width="10" Height="10"
                              Style="{StaticResource IconPath}"
                              Data="{DynamicResource Icon.Close}"
                              Stroke="{DynamicResource Icon.Secondary}" />
                    </Button>
                </Grid>

                <!-- ══════════ 元信息 ══════════ -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,14,24,0">
                    <TextBlock x:Name="PublishedText"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="·" Margin="8,0" FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock x:Name="SizeText"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="·" Margin="8,0" FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Text="通道"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock x:Name="ChannelText" Margin="4,0,0,0"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>

                <!-- ══════════ 更新说明 ══════════ -->
                <Border Grid.Row="2" Margin="24,14,24,0"
                        Background="{DynamicResource Bg.Sunken}"
                        BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <ScrollViewer MaxHeight="200"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="BodyText"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="12.5"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}" />
                    </ScrollViewer>
                </Border>

                <!-- ══════════ 下载进度 / 错误 ══════════ -->
                <StackPanel Grid.Row="3" Margin="24,16,24,0">

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="ProgressTitle"
                                       Text="正在下载"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock x:Name="ProgressPercent"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Accent}" />
                        </Grid>

                        <ProgressBar x:Name="DownloadBar"
                                     Style="{StaticResource Progress.Thin}"
                                     Margin="0,9,0,0"
                                     Minimum="0" Maximum="100" Value="0" />

                        <Grid Margin="0,7,0,0">
                            <TextBlock x:Name="ProgressSize"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="ProgressSpeed"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}" />
                                <TextBlock Text=" · " FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}" />
                                <TextBlock x:Name="ProgressSource"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Path Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0"
                              Style="{StaticResource IconPath}"
                              Data="{DynamicResource Icon.Warning}"
                              Stroke="{DynamicResource Warning}" />
                        <TextBlock x:Name="ErrorText"
                                   Margin="8,0,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Warning}" />
                    </StackPanel>
                </StackPanel>

                <!-- ══════════ 操作区 ══════════ -->
                <StackPanel Grid.Row="4" Margin="24,18,24,22">
                    <Border Height="1" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <Border.Background>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.06" />
                        </Border.Background>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 「不再提示此版本」：用幽灵按钮做开关，避免裸 CheckBox 破坏观感 -->
                        <Button x:Name="SkipButton"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource Btn.Ghost}"
                                Content="不再提示此版本"
                                Click="OnSkipToggleClick" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="LaterButton"
                                    Content="稍后"
                                    Style="{StaticResource Btn.Secondary}"
                                    Click="OnLaterClick" />
                            <Button x:Name="PrimaryButton"
                                    Content="立即更新"
                                    Style="{StaticResource Btn.Primary}"
                                    Margin="10,0,0,0"
                                    Click="OnPrimaryClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
