<Window x:Class="PivotPic.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正画 安装程序"
        Width="780" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal">

    <Border CornerRadius="14" Background="{StaticResource Bg.Window}"
            BorderBrush="{StaticResource Stroke.Soft}" BorderThickness="1"
            MouseLeftButtonDown="OnDragArea">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧品牌区 ============ -->
            <Border Grid.Column="0" Background="{StaticResource Bg.Panel}"
                    CornerRadius="14,0,0,14" MouseLeftButtonDown="OnDragArea">
                <Grid>
                    <!-- 顶部品牌光晕 -->
                    <Ellipse Width="300" Height="300" Fill="{StaticResource Brush.Glow}"
                             VerticalAlignment="Top" HorizontalAlignment="Center"
                             Margin="0,-90,0,0" IsHitTestVisible="False" />

                    <StackPanel VerticalAlignment="Center" Margin="28,0,28,0">
                        <!-- 徽标：与软件本体一致的品牌图 -->
                        <Image x:Name="BrandLogo" Width="76" Height="76" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.42" Color="#5B7BFF" />
                            </Image.Effect>
                        </Image>

                        <TextBlock Text="PivotPic" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}" Margin="0,18,0,0" />
                        <TextBlock Text="正画" FontSize="13"
                                   Foreground="{StaticResource Text.Tertiary}" Margin="0,2,0,0" />

                        <Rectangle Height="1" Fill="{StaticResource Stroke.Soft}" Margin="0,20,0,20" />

                        <TextBlock x:Name="BrandVersion" Text="版本 1.2.0"
                                   FontSize="12" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="鹏飞广告·饺子" FontSize="12"
                                   Foreground="{StaticResource Text.Tertiary}" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Text="横版图片自动转竖版" VerticalAlignment="Bottom" Margin="28,0,0,26"
                               FontSize="11" Foreground="{StaticResource Text.Tertiary}" />
                </Grid>
            </Border>

            <!-- ============ 右侧内容区 ============ -->
            <Grid Grid.Column="1">
                <!-- 关闭按钮 -->
                <Button x:Name="BtnClose" Style="{StaticResource Btn.Close}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                        Click="OnCloseClick" />

                <!-- 页 1：安装选项 -->
                <StackPanel x:Name="PageInstall" Margin="34,46,34,30" VerticalAlignment="Top">
                    <TextBlock Text="安装 PivotPic" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="为所有用户安装到 Program Files，需要管理员权限。"
                               FontSize="12" Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,26,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource Input.Path}" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Btn.Ghost}"
                                Width="88" Height="36" Margin="8,0,0,0" Click="OnBrowseClick" />
                    </Grid>

                    <TextBlock Text="附加选项" FontSize="12" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,24,0,12" />
                    <CheckBox x:Name="ChkDesktop" Content="创建桌面快捷方式" IsChecked="True"
                              Style="{StaticResource Check.Option}" Margin="0,0,0,14" />
                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（静默运行在托盘）" IsChecked="True"
                              Style="{StaticResource Check.Option}" />

                    <TextBlock x:Name="ErrorText" Foreground="#FF7B7B" FontSize="12"
                               TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button Content="取消" Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0"
                                Click="OnCloseClick" />
                        <Button x:Name="BtnInstall" Content="开始安装" Style="{StaticResource Btn.Primary}"
                                Click="OnInstallClick" />
                    </StackPanel>
                </StackPanel>

                <!-- 页 2：安装进度 -->
                <StackPanel x:Name="PageProgress" Margin="34,46,34,30" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="正在安装" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock x:Name="StatusText" Text="准备中…" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,0" />

                    <!-- 当前正在释放的文件与计数，让进度看得见 -->
                    <TextBlock x:Name="DetailText" FontSize="11"
                               Foreground="{StaticResource Text.Tertiary}"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />

                    <Border Height="6" CornerRadius="3" Background="#14FFFFFF" Margin="0,26,0,0">
                        <Border x:Name="BarFill" Height="6" CornerRadius="3"
                                Background="{StaticResource Brush.Accent}"
                                HorizontalAlignment="Left" Width="0" />
                    </Border>

                    <TextBlock x:Name="PercentText" Text="0%" FontSize="11"
                               Foreground="{StaticResource Text.Tertiary}"
                               HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>

                <!-- 页 3：完成 -->
                <StackPanel x:Name="PageDone" Margin="34,46,34,30" VerticalAlignment="Top"
                            Visibility="Collapsed">
                    <Border Width="52" Height="52" CornerRadius="26" Background="#1F3ECF8E"
                            HorizontalAlignment="Left">
                        <Path Data="M1,7 L6,12 L15,2" Stroke="#3ECF8E" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="安装完成" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" Margin="0,18,0,0" />
                    <TextBlock x:Name="DoneText" FontSize="12" Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <CheckBox x:Name="ChkRunNow" Content="立即运行 PivotPic" IsChecked="True"
                              Style="{StaticResource Check.Option}" Margin="0,26,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,34,0,0">
                        <Button x:Name="BtnFinish" Content="完成" Style="{StaticResource Btn.Primary}"
                                Click="OnFinishClick" />
                    </StackPanel>
                </StackPanel>

                <!-- 卸载确认 -->
                <StackPanel x:Name="PageUninstall" Margin="34,46,34,30" VerticalAlignment="Top"
                            Visibility="Collapsed">
                    <TextBlock Text="卸载 PivotPic" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="将删除程序文件、桌面与开始菜单快捷方式，以及开机自启项。"
                               FontSize="12" Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <TextBlock x:Name="UninstallPathText" FontSize="12"
                               Foreground="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Margin="0,18,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,36,0,0">
                        <Button Content="取消" Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0"
                                Click="OnCloseClick" />
                        <Button x:Name="BtnUninstall" Content="确认卸载" Style="{StaticResource Btn.Primary}"
                                Background="#E5484D" Click="OnUninstallClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
