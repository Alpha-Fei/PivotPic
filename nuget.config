<?xml version="1.0" encoding="utf-8"?>
<!--
  国内网络下 api.nuget.org 还原 runtime pack 经常超时（发布自包含单文件时需要）。
  这里默认走华为云镜像；海外环境或企业内网请删除本文件，改用全局 NuGet 配置。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
  </packageSources>
</configuration>
